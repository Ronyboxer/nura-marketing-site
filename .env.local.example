# All three of these are server-side only. None of them is prefixed with
# NEXT_PUBLIC_, and none of them should be. Copy this file to `.env.local` to
# run locally; `.env*` is git-ignored.

# Supabase, used by the /api/waitlist route.
# Settings -> API in your Supabase project.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic, used by the /api/ask route to phrase a matched memory.
# Without it the demo still works and still tells the truth: it returns the
# matched memory exactly as the family wrote it.
ANTHROPIC_API_KEY=your-anthropic-api-key
